#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=WiiM Home
GenericName=Audio Control Center
Comment=Control WiiM devices across your network
Exec=wiim
Icon=org.wiim.home
Terminal=false
Categories=AudioVideo;Audio;Player;Qt;
StartupWMClass=org.wiim.home
X-KDE-Wayland-AppID=org.wiim.home
StartupNotify=true
